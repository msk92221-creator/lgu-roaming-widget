<resources>
    <style name="Theme.RoamingWidget" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/brand_purple_dark</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/brand_purple</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowSplashScreenBackground">@color/brand_purple_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_plane</item>
    </style>

    <style name="Theme.RoamingWidget.Transparent" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/brand_purple</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
